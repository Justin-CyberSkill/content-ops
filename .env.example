# Neon (or any Postgres) connection string. Use the pooled URL from the Neon console.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cs_content_ops
# Direct (non-pooler) Neon URL, used only by drizzle-kit for migrations. Leave empty locally.
DATABASE_URL_UNPOOLED=

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# First admin, created by `pnpm db:seed-admin`. Only the seed script reads these.
ADMIN_EMAIL=
ADMIN_NAME=
